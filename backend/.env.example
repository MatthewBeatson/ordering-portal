PORT=3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cin7 Core API (V2). Use a trial account's credentials for testing --
# never a production account without an explicit go-ahead.
CIN7_API_BASE_URL=https://inventory.dearsystems.com/ExternalApi/v2
CIN7_ACCOUNT_ID=your-cin7-account-id
CIN7_APPLICATION_KEY=your-cin7-application-key

# Shared secret Cin7 attaches as a Bearer token to webhook callbacks --
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CIN7_WEBHOOK_TOKEN=your-generated-webhook-token

# Bulk-approval notification email (optional -- with RESEND_API_KEY or
# EMAIL_FROM unset, approvals still work and are saved/viewable in the app;
# the email is simply skipped and marked 'not_configured').
# RESEND_API_KEY: from the Resend dashboard.
# EMAIL_FROM: sender on a domain verified in Resend, e.g.
#   Shonrei Orders <orders@shonrei.com>
# APPROVAL_NOTIFY_EMAILS: comma-separated extra recipients (e.g. Shonrei
#   staff) who get every approval email; the approver is always included.
# APP_BASE_URL: used for the "View this approval" link (defaults to
#   https://orders.shonrei.com).
RESEND_API_KEY=
EMAIL_FROM=
APPROVAL_NOTIFY_EMAILS=
APP_BASE_URL=
